#!/bin/sh
#
# `deep focus` — start the Deep Work timer.
#
# WHY THIS RUNS ELECTRON DIRECTLY, NOT `npm start`:
# `npm start` stacks two extra processes in front of the app — npm, then a Node
# launcher script. Ctrl+C goes to those, and the real app can survive as an orphan
# that keeps blacking the screen every 90 minutes from a process you cannot see.
#
# WHY THE SHELL KILLS THE APP INSTEAD OF THE APP CATCHING Ctrl+C:
# Electron swallows SIGINT/SIGTERM/SIGHUP in the main process — measured: the app
# kept running with no handler firing at all. So the signal is trapped HERE, in the
# shell, which then kills the child outright. A shell trap cannot be ignored by the
# thing it is killing, which is exactly the property an escape hatch needs.

# WHY THIS RESOLVES THE SYMLINK INSTEAD OF USING `dirname "$0"`:
# `deep` is reached through ~/.local/bin/deep, which is a symlink into this repo.
# `$0` is therefore the LINK, not this file — `dirname "$0"` would give ~/.local/bin
# and the app directory would be wrong. The loop below follows the link chain to the
# real script, then takes its parent's parent. Relative link targets are resolved
# against the directory of the link that named them, which is the only correct rule.

SELF="$0"
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in
    /*) SELF="$LINK" ;;
     *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
APP_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
BIN="$APP_DIR/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"

# WHY MATCH IS BUILT FROM APP_DIR AND NOT HARDCODED:
# This is the pattern `pgrep`/`pkill` use to find a running instance, matched against
# the full command line (`$BIN $APP_DIR`). It used to be the literal string
# "deep-work/node_modules/electron", which silently broke for anyone who cloned the
# repo into a folder with a different name: `deep stop` said "Not running" while the
# app kept blacking the screen, and the already-running guard never fired.
# Deriving it from APP_DIR also makes it precise — `deep stop` in one clone cannot
# kill an instance started from a different clone.
MATCH="$APP_DIR/node_modules/electron"

usage() {
  echo "deep focus    start the timer — 90 min work, 5 min enforced break, looping"
  echo "deep stop     kill any running instance (including one you cannot see)"
  echo ""
  echo "While it runs: Ctrl+C quits. Cmd+Ctrl+Option+Q quits from anywhere."
}

case "$1" in
  focus)
    # The break screen relies on the macOS `screen-saver` window level and on the
    # macOS app menu to disable Cmd+Q. Neither exists elsewhere, so refuse early
    # rather than half-work.
    if [ "$(uname -s)" != "Darwin" ]; then
      echo "Deep Work is macOS only — the enforced break screen is built on macOS window levels." >&2
      exit 1
    fi
    if [ ! -x "$BIN" ]; then
      echo "Electron is not installed yet. Run:" >&2
      echo "  cd \"$APP_DIR\" && npm install" >&2
      exit 1
    fi
    if pgrep -f "$MATCH" >/dev/null 2>&1; then
      echo "Deep Work is already running. Use 'deep stop' first." >&2
      exit 1
    fi
    echo "Deep Work — 90 min focus, then a 5 min break the screen enforces."
    echo "Ctrl+C to quit."
    "$BIN" "$APP_DIR" &
    CHILD=$!
    trap 'kill $CHILD 2>/dev/null; sleep 1; kill -9 $CHILD 2>/dev/null; echo ""; echo "Stopped."; exit 0' INT TERM HUP
    wait $CHILD
    ;;
  stop)
    if pgrep -f "$MATCH" >/dev/null 2>&1; then
      pkill -f "$MATCH"
      sleep 1
      pkill -9 -f "$MATCH" 2>/dev/null
      echo "Stopped."
    else
      echo "Not running."
    fi
    ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $1" >&2; echo ""; usage; exit 1 ;;
esac
